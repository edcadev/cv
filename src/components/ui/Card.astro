---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["card", className]}>
  <slot />
</div>

<style>
  .card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid hsl(220 14.3% 90%);
    border-radius: 0.5rem;
    padding: 12px;
    background: hsl(0 0% 100%);
  }
</style>
